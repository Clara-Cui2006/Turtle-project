{
  "name": "turtle-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @turtle/server\" \"npm run dev -w @turtle/web\"",
    "build": "npm run build -w @turtle/shared && npm run build -w @turtle/server && npm run build -w @turtle/web",
    "test": "vitest run --pool=vmThreads --maxWorkers=1 --minWorkers=1",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
